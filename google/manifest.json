{
  "manifest_version": 3,
  "name": "VirusTotal Extension",
  "version": "1.0",
  "description": "Uses the VirusTotal api to scan a website and tell if it is safe or not",

  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  
  "host_permissions": [
    "<all_urls>",
    "https://www.virustotal.com/api/v3/domains/*"
  ],

  "action": {
    "default_popup": "../html/popup.html",
    
    "default_icon": {
      "16": "images/image16.png",
      "32": "images/image32.png"
    }
  },

  "icons": {
    "16": "images/image16.png",
    "48": "images/image48.png",
    "128": "images/image128.png"
  },


  "background": {
    "service_worker": "../js/extension.js"
  }
}